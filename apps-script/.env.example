# Памятка для Apps Script -> Project Settings -> Script Properties.
# Apps Script НЕ загружает этот файл. Значения задаются вручную в Google.
# Не копируйте файл в dist/ и не добавляйте реальные секреты в *.example.

# ID таблицы из https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit.
SPREADSHEET_ID=REPLACE_WITH_EXISTING_SPREADSHEET_ID

# Секрет подписи запросов, минимум 32 символа; для нового backend — случайный ключ.
# Значение оставлено пустым намеренно, готового рабочего ключа здесь нет.
# Для существующего backend СОХРАНИТЕ его текущий ключ, не генерируйте новый при смене устройства.
# Тот же ключ вводится в Settings расширения -> Session signing key.
SIGNING_KEY=

# На другом компьютере при подключении к тому же Web App серверные свойства уже существуют:
# не меняйте их и не запускайте setup ради переноса расширения.
# Google OAuth (clasp/Drive) и SIGNING_KEY — разные механизмы авторизации.
