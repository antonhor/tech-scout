# TechScout: памятка по настройке на другом устройстве.
# ВАЖНО: проект сейчас НЕ читает .env автоматически.
# Этот файл не подставляется в сборку и не настраивает Google/Chrome.
# Рабочие значения перенесите в JSON-файлы и Settings, указанные ниже.
# При желании скопируйте файл в .env для локальных заметок (.env исключён из Git).

# Apps Script -> Project Settings -> Script ID.
# Записать как scriptId в .clasp.json И .clasp.deploy.json (одинаковое значение).
APPS_SCRIPT_ID=REPLACE_WITH_APPS_SCRIPT_ID

# Apps Script -> Deploy -> Manage deployments -> существующий Web App -> Deployment ID.
# Записать как deploymentId в .clasp.deploy.json.
# Не использовать ID deployment с пометкой HEAD и не создавать новый Web App для переноса.
APPS_SCRIPT_DEPLOYMENT_ID=REPLACE_WITH_EXISTING_DEPLOYMENT_ID

# URL существующего Web App -> поле Apps Script Web App URL в Settings расширения.
# Обязателен адрес /exec; /dev не подходит.
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_WITH_EXISTING_DEPLOYMENT_ID/exec

# Google Drive: ID после /folders/ в ссылке на папку релизов.
# Записать как folderId в .drive-release.json.
GOOGLE_DRIVE_FOLDER_ID=REPLACE_WITH_GOOGLE_DRIVE_FOLDER_ID

# Профили Google OAuth: используются командами проекта.
# Это имена локальных профилей, НЕ адреса электронной почты и НЕ токены.
# Вход выполнить заново на каждом устройстве; файлы .clasprc*.json не переносить через Git.
APPS_SCRIPT_AUTH_PROFILE=techscout
GOOGLE_DRIVE_AUTH_PROFILE=techscout-drive

# SIGNING_KEY не задаётся через этот .env и не встраивается в ZIP.
# Для существующего backend используйте его текущий ключ из Script Properties:
# введите его вручную в Settings расширения -> Session signing key.
# Настройки серверных свойств описаны в apps-script/.env.example.
